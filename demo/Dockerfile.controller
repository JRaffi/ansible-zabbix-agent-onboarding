# Ansible controller, so trying this out needs nothing but Docker.
FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-client curl ca-certificates \
 && apt-get clean && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir "ansible-core>=2.17,<2.19"

# Deliberately no collections and no jmespath: the playbook must work with a
# bare ansible-core install. If something here is needed, that is a bug.

WORKDIR /repo
